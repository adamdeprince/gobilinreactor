+/* A launcher may grant an already-open file without granting pathname access.
+ * In particular, Android isolated services cannot reopen private files through
+ * /proc/self/fd. Keep the original descriptor alive and duplicate it directly.
+ * Return -1 for an ordinary pathname; reject malformed fd: names explicitly.
+ */
+static int inherited_file(const char *name)
+{
+	unsigned int fd = 0;
+
+	if (strncmp(name, "fd:", 3))
+		return -1;
+	name += 3;
+	if (!*name)
+		return -EINVAL;
+	while (*name) {
+		if (*name < '0' || *name > '9' ||
+		    fd > (INT_MAX - (*name - '0')) / 10U)
+			return -EINVAL;
+		fd = fd * 10 + *name++ - '0';
+	}
+	return fd;
+}
 
