+#ifdef __ANDROID__
+// POSIX named shared memory is unavailable in an Android app. Guest graphics
+// uses in-band data; never translate untrusted names into broker paths.
+#include <errno.h>
+static inline int goblin_android_shm_open(const char *n, int f, mode_t m) { (void)n; (void)f; (void)m; errno = ENOTSUP; return -1; }
+static inline int goblin_android_shm_unlink(const char *n) { (void)n; errno = ENOTSUP; return -1; }
+static inline void goblin_android_bzero(void *p, size_t n) { volatile unsigned char *v = p; while (n--) *v++ = 0; }
+#define shm_open goblin_android_shm_open
+#define shm_unlink goblin_android_shm_unlink
+#define explicit_bzero goblin_android_bzero
+#endif
